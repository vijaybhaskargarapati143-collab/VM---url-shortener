# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file.

# Port the backend listens on
PORT=5000

# MongoDB connection string.
# Local MongoDB:  mongodb://127.0.0.1:27017/url_shortener
# MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/url_shortener
MONGODB_URI=mongodb://127.0.0.1:27017/url_shortener

# Public base URL used to build short links (what people actually click).
# Locally this is the backend, because the backend performs the redirect.
BASE_URL=http://localhost:5000

# Frontend origin allowed to call the API (CORS)
CLIENT_ORIGIN=http://localhost:5173
